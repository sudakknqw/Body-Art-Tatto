---
import View from '../../../views/Piece.astro';
import { sites, langParam } from '../../../lib/content';

export function getStaticPaths() {
  return sites.flatMap((s) =>
    s.pieces.map((x) => ({ params: { lang: langParam(s.lang), slug: x.slug }, props: { lang: s.lang } })),
  );
}
---

<View lang={Astro.props.lang} slug={Astro.params.slug} />
