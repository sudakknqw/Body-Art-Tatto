---
// Responsive <picture>: AVIF (q65) + WebP (q72) + JPEG fallback,
// 400/600/800/1200/1600w, explicit width/height so nothing shifts.
//
// `wait`: the photo is never on the first screen, so the page doesn't request
// it until it comes near (src/scripts/site.ts, loadPhoto). The browser's own
// loading="lazy" starts 1250–2500px early, which on a feed is every photo.
// Without JavaScript the <noscript> copy loads as usual.
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  eager?: boolean;
  /** Fetch ahead of other photos (fetchpriority="high"); defaults to `eager`. */
  priority?: boolean;
  wait?: boolean;
}

const { src, alt, sizes, eager = false, priority = eager, wait = false } = Astro.props;
const all = [400, 600, 800, 1200, 1600];
const widths = all.filter((w) => w <= src.width);
// A photo smaller than 1600px also offers its own full width.
if (src.width < 1600 && !widths.includes(src.width)) widths.push(src.width);

const [avif, webp, jpg] = await Promise.all([
  getImage({ src, widths, format: 'avif', quality: 65 }),
  getImage({ src, widths, format: 'webp', quality: 72 }),
  getImage({ src, widths, format: 'jpg', quality: 80 }),
]);
const fallback = await getImage({ src, width: Math.min(800, src.width), format: 'jpg', quality: 80 });
// Transparent 1×1 GIF: keeps the <img> "loaded" (no alt text drawn) while it waits.
const BLANK = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
const img = { sizes, width: src.width, height: src.height, alt };
---

{wait ? (
  <>
    <picture class="photo" data-wait>
      <source type="image/avif" data-srcset={avif.srcSet.attribute} sizes={sizes} />
      <source type="image/webp" data-srcset={webp.srcSet.attribute} sizes={sizes} />
      <img src={BLANK} data-src={fallback.src} data-srcset={jpg.srcSet.attribute} {...img} decoding="async" />
    </picture>
    <noscript>
      <picture class="photo">
        <source type="image/avif" srcset={avif.srcSet.attribute} sizes={sizes} />
        <source type="image/webp" srcset={webp.srcSet.attribute} sizes={sizes} />
        <img src={fallback.src} srcset={jpg.srcSet.attribute} {...img} loading="lazy" decoding="async" />
      </picture>
    </noscript>
  </>
) : (
  <picture class="photo">
    <source type="image/avif" srcset={avif.srcSet.attribute} sizes={sizes} />
    <source type="image/webp" srcset={webp.srcSet.attribute} sizes={sizes} />
    <img
      src={fallback.src}
      srcset={jpg.srcSet.attribute}
      {...img}
      loading={eager ? 'eager' : 'lazy'}
      decoding={eager ? 'auto' : 'async'}
      fetchpriority={priority ? 'high' : undefined}
    />
  </picture>
)}
