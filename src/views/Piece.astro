---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { BP, PHOTO_COL } from '../lib/layout';
import { site as getSite, feedOf, feedOfDesktop, fill, whatsappHref, type Lang } from '../lib/content';

interface Props {
  lang: Lang;
  slug: string;
}
const site = getSite(Astro.props.lang);
const { studio, styles, copy, prefix } = site;
const piece = site.pieces.find((p) => p.slug === Astro.props.slug)!;
const style = styles.find((s) => s.slug === piece.style)!;
// Prev/next follow the feed as it is read: phones and desktop lay the mosaic
// out differently, so each gets its own pair of arrows (CSS shows one).
const around = (list: typeof site.pieces) => {
  const at = list.indexOf(piece);
  return list.length > 1 ? { prev: list[(at - 1 + list.length) % list.length], next: list[(at + 1) % list.length] } : null;
};
const phone = around(feedOf(site, style));
const desktop = around(feedOfDesktop(site, style));
const sameArrows = phone?.prev === desktop?.prev && phone?.next === desktop?.next;
const arrowSets = phone && desktop ? (sameArrows ? [{ set: phone, cls: '' }] : [{ set: phone, cls: 'arrows--phone' }, { set: desktop, cls: 'arrows--desktop' }]) : [];
const tileIndex = (site.pieces.indexOf(piece) % 6) + 1;

const extras = [
  piece.photoDetail && { src: piece.photoDetail, label: copy.detail },
  piece.photoHealed && { src: piece.photoHealed, label: copy.healed },
].filter(Boolean) as { src: ImageMetadata; label: string }[];

// Link in the WhatsApp message always points at the English URL: shortest, and the artist reads it.
const pageUrl = new URL(`/work/${piece.slug}/`, Astro.site);
const shortUrl = `${pageUrl.host}${pageUrl.pathname}`;
const bookHref = whatsappHref(studio, fill(copy.waPiece, { name: piece.name, url: shortUrl }));

const sessionsLabel = piece.sessions ? `${piece.sessions} ${piece.sessions === '1' ? copy.session : copy.sessions}` : '';
const title = fill(copy.titles.piece, { piece: piece.name, style: style.name, name: studio.name, area: studio.addressShort });
const description = piece.note || piece.alt;

const full = await getImage({ src: piece.photo, width: Math.min(1600, piece.photo.width), format: 'jpg', quality: 80 });
const imageLd = {
  '@context': 'https://schema.org',
  '@type': 'ImageObject',
  contentUrl: new URL(full.src, Astro.site).href,
  url: new URL(Astro.url.pathname, Astro.site).href,
  name: piece.name,
  description: piece.alt,
  caption: piece.note || undefined,
  width: full.attributes.width,
  height: full.attributes.height,
  creator: { '@type': 'Person', name: studio.artist },
  copyrightHolder: { '@id': new URL('/#business', Astro.site).href },
  creditText: studio.name,
};
---

<Base
  page="piece"
  site={site}
  title={title}
  description={description}
  image={piece.photo}
  imageAlt={piece.alt}
  jsonLd={[imageLd]}
  bookHref={bookHref}
  bookLabel={copy.bookPiece}
  bookCaption={copy.bookPieceCaption}
  headerOverlay
>
  <main class="piece">
    <div class="media">
      <div class="main-photo" style={`background:var(--tile-${tileIndex})`}>
        <Photo src={piece.photo} alt={piece.alt} eager sizes={`(min-width: ${BP.desktop}px) ${PHOTO_COL}, 100vw`} />
        <a class="on-photo back" href={`${prefix}/style/${style.slug}/`}>
          <span aria-hidden="true">←</span> {fill(copy.backTo, { style: style.name })}
        </a>
        {arrowSets.map(({ set, cls }, i) => (
          <div class:list={['arrows', cls]}>
            <a class="on-photo arrow" href={`${prefix}/work/${set.prev.slug}/`} aria-label={copy.prevPiece} rel={i === 0 ? 'prev' : undefined}>
              <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M11 3 5 9l6 6" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
            </a>
            <a class="on-photo arrow" href={`${prefix}/work/${set.next.slug}/`} aria-label={copy.nextPiece} rel={i === 0 ? 'next' : undefined}>
              <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="m7 3 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
            </a>
          </div>
        ))}
      </div>

      {extras.length > 0 && (
        <ul class:list={['extras', { 'extras--one': extras.length === 1 }]}>
          {extras.map((x, i) => (
            <li style={`background:var(--tile-${((tileIndex + i) % 6) + 1})`}>
              <figure>
                <Photo src={x.src} alt={`${piece.alt} — ${x.label}`} sizes={`(min-width: ${BP.desktop}px) ${extras.length === 1 ? PHOTO_COL : `calc(${PHOTO_COL} / 2)`}, 80vw`} />
                <figcaption>{x.label}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
      )}
    </div>

    <div class="info">
      <p class="eyebrow">{[style.name, sessionsLabel].filter(Boolean).join(' · ')}</p>
      <h1>{piece.name}</h1>
      {piece.note && <p class="note muted">{piece.note}</p>}
      <ul class="pills">
        {piece.placement && <li><span class="visually-hidden">{copy.placement}: </span>{piece.placement}</li>}
        {piece.sizeCm && <li><span class="visually-hidden">{copy.size}: </span>{piece.sizeCm} {copy.cm}</li>}
        {piece.hours && <li><span class="visually-hidden">{copy.hours}: </span>{piece.hours} {copy.hoursShort}</li>}
        {piece.price && <li><span class="visually-hidden">{copy.price}: </span>{piece.price} {copy.thb}</li>}
      </ul>
      <div class="book">
        <a class="btn btn--block" href={bookHref}>{copy.bookPiece}</a>
        <p class="caption">{copy.bookPieceCaption}</p>
      </div>
    </div>
  </main>
</Base>

<style>
  .main-photo { position: relative; aspect-ratio: 4 / 5; }
  .main-photo :global(img) { position: absolute; inset: 0; }
  /* Shared with the tapped feed photo, so it expands into place (src/scripts/site.ts) */
  @media (prefers-reduced-motion: no-preference) {
    .main-photo :global(img) { view-transition-name: piece-photo; }
  }

  /* Scrim 2 of 2: controls that sit on the photo stay dark with light text in both themes */
  .on-photo {
    position: absolute;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--s8);
    background: var(--photo-scrim);
    color: var(--on-photo);
    text-decoration: none;
    font-size: 14px;
  }
  .on-photo:focus-visible { outline-color: var(--on-photo-focus); outline-offset: -2px; }
  .back { top: var(--s12); left: var(--s12); min-height: 44px; padding: 0 var(--s12); }
  .arrows { position: absolute; left: var(--s12); bottom: var(--s12); display: flex; gap: var(--s2); }
  .arrow { position: static; width: 46px; height: 46px; }
  .arrows--desktop { display: none; }

  .extras {
    list-style: none;
    padding: 0;
    display: flex;
    gap: var(--gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    background: var(--seam);
    border-top: var(--gap) solid var(--seam);
  }
  .extras li { flex: 0 0 80%; scroll-snap-align: start; }
  .extras--one li { flex-basis: 100%; }
  figure { position: relative; aspect-ratio: 4 / 5; }
  figure :global(img) { position: absolute; inset: 0; }
  figcaption {
    position: absolute;
    left: var(--s12);
    bottom: var(--s12);
    padding: var(--s4) var(--s8);
    background: var(--photo-scrim);
    color: var(--on-photo);
    font-size: 13px;
  }

  .info { padding: var(--s22) var(--s16) var(--s30); }
  h1 { font-size: 32px; margin-top: var(--s8); }
  .note { margin-top: var(--s16); }
  .pills {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s8);
    margin-top: var(--s22);
  }
  .pills li {
    border: 1px solid var(--border);
    padding: var(--s8) var(--s12);
    font-size: 14px;
  }
  .book { display: none; }

  @media (min-width: 1024px) {
    .arrows--phone { display: none; }
    .arrows--desktop { display: flex; }
    .piece {
      display: grid;
      grid-template-columns: var(--photo-col) minmax(0, 1fr);
      align-items: start;
    }
    .main-photo { aspect-ratio: auto; height: 100vh; height: 100svh; }
    .extras { overflow: visible; }
    .extras li { flex: 1 1 0; }
    .info {
      position: sticky;
      top: 0;
      min-height: 100vh;
      min-height: 100svh;
      display: flex;
      flex-direction: column;
      padding: calc(var(--header-h) + var(--s56)) var(--s56) var(--s40);
      max-width: 720px;
    }
    h1 { font-size: 42px; }
    .note { font-size: 18px; margin-top: var(--s22); }
    .pills { margin-top: var(--s30); }
    .book { display: block; margin-top: auto; padding-top: var(--s40); max-width: 420px; }
    .book .caption { margin-top: var(--s8); text-align: center; }
  }
</style>
